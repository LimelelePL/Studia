  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background-color: #202124;
    color: #eeeeee;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel {
    color: #eeeeee;
    background: transparent;
}

QLineEdit, QPlainTextEdit {
    background-color: #2b2d31;
    color: #f2f2f2;
    border: 1px solid #555b63;
    border-radius: 6px;
    padding: 4px 6px;
}

QLineEdit:read-only, QPlainTextEdit:read-only {
    background-color: #25272b;
    color: #dcdcdc;
}

QListWidget {
    background-color: #181a1f;
    color: #eeeeee;
    border: 1px solid #555b63;
    border-radius: 8px;
    padding: 4px;
}

QListWidget::item {
    padding: 5px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #2d89ef;
    color: white;
}

QPushButton {
    background-color: #2d89ef;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3b97ff;
}

QPushButton:pressed {
    background-color: #1f6fc7;
}

QPushButton:disabled {
    background-color: #4a4a4a;
    color: #9a9a9a;
}

QStatusBar {
    background-color: #202124;
    color: #cccccc;
}</string>
